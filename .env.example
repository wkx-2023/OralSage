QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Learning-profile memory extraction. Leave the key empty to reuse QWEN_API_KEY.
LEARNING_MEMORY_LLM_API_KEY=
LEARNING_MEMORY_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LEARNING_MEMORY_LLM_MODEL=qwen-plus

LLM_REQUEST_TIMEOUT_SECONDS=180

# Decision assistant: use a stronger model for clinical reasoning.
# Leave API key/base URL empty to reuse QWEN_API_KEY and QWEN_BASE_URL.
DECISION_LLM_API_KEY=
DECISION_LLM_BASE_URL=
DECISION_LLM_MODEL=qwen-max

# Literature summary/translation: can use a faster, cheaper model.
# Leave API key/base URL empty to reuse QWEN_API_KEY and QWEN_BASE_URL.
LITERATURE_LLM_API_KEY=
LITERATURE_LLM_BASE_URL=
LITERATURE_LLM_MODEL=qwen-plus

# Pathology QA: use a stronger model when generating evidence-grounded answers.
# Leave API key/base URL empty to reuse QWEN_API_KEY and QWEN_BASE_URL.
PATHOLOGY_LLM_API_KEY=
PATHOLOGY_LLM_BASE_URL=
PATHOLOGY_LLM_MODEL=qwen-max

# Cloud vision assistant: first-pass image recognition through a Qwen-VL
# OpenAI-compatible endpoint. Leave API key empty to reuse QWEN_API_KEY.
VISION_LLM_API_KEY=
VISION_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_LLM_MODEL=qwen2.5-vl-7b-instruct
VISION_LLM_TIMEOUT_SECONDS=180
VISION_MAX_IMAGE_MB=10

# Medical record extraction: keep separate if you want JSON stability tuning.
RECORD_LLM_API_KEY=
RECORD_LLM_BASE_URL=
RECORD_LLM_MODEL=qwen-plus

QWEN_RERANK_MODEL=qwen3-rerank
QWEN_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
QWEN_RERANK_TIMEOUT_SECONDS=45

PUBMED_CONTACT_EMAIL=
ELSEVIER_API_KEY=
ELSEVIER_INSTITUTION_TOKEN=

# ASR Configuration
# WHISPER_MODEL: base, tiny, small, medium, large-v3
WHISPER_MODEL=base

# Learning slide-level TTS (iFLYTEK long-text TTS)
# Generated output:
#   data/learning/sessions/{session_id}/audio_manifest.json
#   data/learning/sessions/{session_id}/audio_files/{outline_node_id}/slide_001.mp3
LEARNING_AUDIO_TTS_ENABLED=true
# Limit concurrent section-level TTS jobs. PPT generation uses a separate worker.
LEARNING_AUDIO_MAX_CONCURRENCY=2
XF_TTS_CREATE_URL=https://api-dx.xf-yun.com/v1/private/dts_create
XF_TTS_QUERY_URL=https://api-dx.xf-yun.com/v1/private/dts_query
XF_TTS_APP_ID=
XF_TTS_API_KEY=
XF_TTS_API_SECRET=
XF_TTS_VCN=x4_mingge
XF_TTS_LANGUAGE=zh
XF_TTS_ENCODING=lame
XF_TTS_SAMPLE_RATE=16000
XF_TTS_SPEED=50
XF_TTS_VOLUME=50
XF_TTS_PITCH=50
XF_TTS_RAM=0
XF_TTS_RHY=0
XF_TTS_TIMEOUT_SECONDS=600
XF_TTS_POLL_INTERVAL_SECONDS=1

# Full question bank used for the personalized final exam. Relative paths are
# resolved from the repository root. The KAG questions.jsonl supplies KG links.
LEARNING_QUESTION_BANK_PATH=data/question_bank/question_bank.json
LEARNING_FINAL_EXAM_QUESTION_COUNT=10

# Weixin ClawBot / ClawBridge integration
# Backend account session cookie and local SQLite binding store.
ORALSAGE_SESSION_COOKIE_NAME=oralsage_session
ORALSAGE_SESSION_TTL_HOURS=720
ORALSAGE_WEIXIN_AUTH_DB=data/weixin/weixin_auth.sqlite3

# Keep this value identical for the Python backend and the Node ClawBridge.
ORALSAGE_CLAWBRIDGE_INTERNAL_SECRET=oralsage-local-dev-secret
CLAWBRIDGE_INTERNAL_SECRET=oralsage-local-dev-secret
CLAWBRIDGE_BASE_URL=http://127.0.0.1:8787
CLAWBRIDGE_BACKEND_BASE_URL=http://127.0.0.1:8000
CLAWBRIDGE_PUBLIC_BASE_URL=http://127.0.0.1:8787
CLAWBRIDGE_INSTANCE_ID=oralsage-clawbridge-local
CLAWBRIDGE_RUNTIME_DIR=./runtime

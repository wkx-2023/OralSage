{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oraledu-kb/alignment.schema.json",
  "title": "AlignmentEdge",
  "type": "object",
  "required": [
    "alignment_id",
    "from_id",
    "to_id",
    "relation",
    "method_chain",
    "verification_status"
  ],
  "properties": {
    "alignment_id": { "type": "string" },
    "from_id": { "type": "string" },
    "to_id": { "type": "string" },
    "relation": { "type": "string" },
    "score": {},
    "method_chain": { "type": "array", "items": { "type": "string" } },
    "evidence_quote": { "type": "string" },
    "verification_status": { "type": "string" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": true
}

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
LLM_REQUEST_TIMEOUT_SECONDS=180

# Decision assistant: use a stronger model for clinical reasoning.
# Leave API key/base URL empty to reuse QWEN_API_KEY and QWEN_BASE_URL.
DECISION_LLM_API_KEY=
DECISION_LLM_BASE_URL=
DECISION_LLM_MODEL=qwen-max

# Literature summary/translation: can use a faster, cheaper model.
# Leave API key/base URL empty to reuse QWEN_API_KEY and QWEN_BASE_URL.
LITERATURE_LLM_API_KEY=
LITERATURE_LLM_BASE_URL=
LITERATURE_LLM_MODEL=qwen-plus

# Pathology QA: use a stronger model when generating evidence-grounded answers.
# Leave API key/base URL empty to reuse QWEN_API_KEY and QWEN_BASE_URL.
PATHOLOGY_LLM_API_KEY=
PATHOLOGY_LLM_BASE_URL=
PATHOLOGY_LLM_MODEL=qwen-max

# Cloud vision assistant: first-pass image recognition through a Qwen-VL
# OpenAI-compatible endpoint. Leave API key empty to reuse QWEN_API_KEY.
VISION_LLM_API_KEY=
VISION_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_LLM_MODEL=qwen2.5-vl-7b-instruct
VISION_LLM_TIMEOUT_SECONDS=180
VISION_MAX_IMAGE_MB=10

# Medical record extraction: keep separate if you want JSON stability tuning.
RECORD_LLM_API_KEY=
RECORD_LLM_BASE_URL=
RECORD_LLM_MODEL=qwen-plus

QWEN_RERANK_MODEL=qwen3-rerank
QWEN_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
QWEN_RERANK_TIMEOUT_SECONDS=45

PUBMED_CONTACT_EMAIL=
ELSEVIER_API_KEY=
ELSEVIER_INSTITUTION_TOKEN=

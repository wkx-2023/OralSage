{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oraledu-kb/clinical_rule.schema.json",
  "title": "ClinicalRule",
  "type": "object",
  "required": [
    "rule_id",
    "rule_type",
    "statement",
    "source_document_id",
    "evidence_chunk_id",
    "evidence_quote",
    "verification_status"
  ],
  "properties": {
    "rule_id": { "type": "string" },
    "rule_type": { "type": "string" },
    "statement": { "type": "string" },
    "condition": { "type": "string" },
    "applies_to_kg_node_ids": { "type": "array", "items": { "type": "string" } },
    "source_document_id": { "type": "string" },
    "evidence_chunk_id": { "type": "string" },
    "evidence_quote": { "type": "string" },
    "authority_level": { "type": "integer" },
    "verification_status": { "type": "string" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": true
}
